ENVIRONMENT=development

# Docker Compose default (see ../docker-compose.yml). For local dev without
# Docker/Postgres, point this at SQLite instead:
#   DATABASE_URL=sqlite:///./careerpilot_dev.db
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot

REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=careerpilot-password

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env

PRIMARY_LLM_API_KEY=
SECONDARY_LLM_API_KEY=

DEMO_STUDENT_EMAIL=demo.student@careerpilot.ai
DEMO_STUDENT_PASSWORD=DemoPass!2026
