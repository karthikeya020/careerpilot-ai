ENVIRONMENT=development

# Docker Compose default. For local dev without Docker/Postgres, you can
# point this at SQLite instead: sqlite:///./careerpilot_dev.db
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot

REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

PRIMARY_LLM_API_KEY=
SECONDARY_LLM_API_KEY=

# Demo account credentials used by `python -m app.seed.seed_demo`.
DEMO_STUDENT_EMAIL=demo.student@careerpilot.ai
DEMO_STUDENT_PASSWORD=DemoPass!2026

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
